# .env.example — daftar environment variable BWDCS
#
# Sumber tunggal daftar ini: docs/design/60-DEPLOYMENT.md §2.1.
# Cara pakai: salin menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# PENTING: `.env` TIDAK boleh di-commit; `.gitignore` sudah menutupinya (T-002a).
# Nilai di bawah adalah contoh, bukan nilai produksi. Jangan pakai di server.
#
# Nilai yang memuat SPASI harus dikutip (`KEY="dua kata"`): Makefile backend dan
# skrip dev memuat berkas ini lewat `set -a; . .env; set +a`, dan tanpa kutip
# shell memotong nilainya pada spasi pertama.

# ---------------------------------------------------------------------------
# WAJIB
# ---------------------------------------------------------------------------

# Password database. Dipakai juga oleh container PostgreSQL di docker-compose.
DB_PASSWORD=ganti-password-ini-minimal-16-karakter

# Kunci tanda tangan JWT, minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter

# ---------------------------------------------------------------------------
# KONEKSI DATABASE
#
# Nilai DB_HOST bergantung pada cara aplikasi dijalankan (port tetap 5432):
#   - Docker Compose (default)           : DB_HOST=postgres              <- nilai aktif di bawah
#   - PostgreSQL host, aplikasi di Docker : DB_HOST=host.docker.internal
#   - Aplikasi langsung di host (`go run`): DB_HOST=localhost
#
# Mesin development ini sudah memiliki PostgreSQL 16.10 di host:5432 (STATE.md §2),
# jadi dua mode terakhir langsung dapat dipakai tanpa container database.
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bwdcs
DB_USER=bwdcs

# ---------------------------------------------------------------------------
# BOOTSTRAP ADMIN PERTAMA (ADR-0010)
#
# Hanya dipakai bila tabel `users` masih kosong. Setelah admin pertama dibuat,
# nilai ADMIN_PASSWORD boleh dikosongkan atau dihapus dari environment.
# ADMIN_PASSWORD wajib minimal 12 karakter dan bukan nilai contoh; bila tidak
# memenuhi, aplikasi berhenti dengan pesan jelas (bukan diam-diam memakai default).
# ---------------------------------------------------------------------------
ADMIN_ORG_NAME="Organisasi Contoh"
ADMIN_ORG_CODE=MYORG
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-minimal-12
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# APLIKASI
# ---------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
JWT_EXPIRY=24h
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PENYIMPANAN FILE
# STORAGE_TYPE: local (MVP). S3-compatible menyusul (ADR-0005).
# STORAGE_PATH: path absolut di dalam container, atau path lokal saat dev di host.
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=./storage

# ---------------------------------------------------------------------------
# OPSIONAL
# ---------------------------------------------------------------------------
# Redis tidak wajib di MVP. Biarkan kosong untuk nonaktif. Invalidasi token
# memakai tabel `token_revocations` di PostgreSQL (ADR-0009), bukan Redis.
REDIS_URL=

# Port di SISI HOST untuk docker-compose, bukan port aplikasi.
# 8081 karena 8080 sudah dipakai proses lain di mesin development ini; 5433
# karena 5432 sudah dipakai PostgreSQL 16 yang berjalan di host.
APP_HOST_PORT=8081
POSTGRES_HOST_PORT=5433
