# Variabel frontend BWDCS. Salin menjadi `.env.local` bila ingin mengubah nilai
# bawaan; `.env.local` tidak di-commit.
#
# Aturan: hanya variabel berawalan `VITE_` yang terekspos ke kode klien, jadi
# JANGAN menaruh sandi atau kunci rahasia di sini. Daftar lengkap variabel
# runtime ada di `docs/design/60-DEPLOYMENT.md` §2.1.

# Port dev server Vite. Default 5173 (`12-DEVELOPMENT-WORKFLOW.md` §7.1).
VITE_DEV_PORT=5173

# Target proxy untuk prefix `/api`. Di mesin development ini backend berjalan di
# 8081 (APP_HOST_PORT), sedangkan dokumen menyebut 8080. Ubah bila berbeda.
VITE_API_PROXY_TARGET=http://localhost:8081

# Base URL API yang dipakai kode klien. Kosongkan untuk memakai jalur relatif
# `/api/v1` lewat proxy dev server (pilihan default, bebas CORS).
VITE_API_BASE_URL=/api/v1

# Port `vite preview` setelah build.
VITE_PREVIEW_PORT=4173
